ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# Email alerts — uses Gmail SMTP
# ALERT_EMAIL_FROM: the Gmail address that sends the alert
# ALERT_EMAIL_PASSWORD: Gmail App Password (16 chars, from myaccount.google.com > Security > App Passwords)
# ALERT_EMAIL_TO: where alerts go (can be same as FROM, or your real email)
ALERT_EMAIL_TO=your-email@example.com
ALERT_EMAIL_FROM=your-gmail@gmail.com
ALERT_EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
