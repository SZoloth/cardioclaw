# Copy to .env. Never commit the real file.

CARDIOCLAW_ENVIRONMENT=development

# Storage
CARDIOCLAW_DATA_DIR=~/CardioClaw/data
CARDIOCLAW_RELEASE_RETENTION=8
CARDIOCLAW_COVER_PATH=./cover.png

# NCBI requires an operational contact address.
CARDIOCLAW_NCBI_EMAIL=operator@example.com
CARDIOCLAW_NCBI_TOOL=cardioclaw
CARDIOCLAW_NCBI_API_KEY=

# Summarization
CARDIOCLAW_ANTHROPIC_API_KEY=
CARDIOCLAW_ANTHROPIC_MODEL=claude-sonnet-4-6

# Natural narration
CARDIOCLAW_OPENAI_API_KEY=
CARDIOCLAW_OPENAI_TTS_MODEL=gpt-4o-mini-tts
CARDIOCLAW_OPENAI_VOICE=nova

# Selection policy
CARDIOCLAW_MIN_NUCLEAR_FINDINGS=5
CARDIOCLAW_MAX_FINDINGS=8
CARDIOCLAW_MIN_SELECTION_SCORE=25
CARDIOCLAW_FULL_TEXT_ENABLED=true

# Private podcast delivery.
# Production must use HTTPS and a long random token.
CARDIOCLAW_PUBLIC_BASE_URL=http://127.0.0.1:5000
CARDIOCLAW_FEED_TOKEN=development-feed-token
CARDIOCLAW_SHOW_TITLE=Cardiology Report
CARDIOCLAW_SERVER_HOST=127.0.0.1
CARDIOCLAW_SERVER_PORT=5000

# Optional email alerts
CARDIOCLAW_ALERT_EMAIL_TO=
CARDIOCLAW_ALERT_EMAIL_FROM=
CARDIOCLAW_ALERT_EMAIL_PASSWORD=
CARDIOCLAW_SMTP_HOST=smtp.gmail.com
CARDIOCLAW_SMTP_PORT=465
